    [self showGameView];
 
+#ifdef PULSTAR_AUTOLOAD
+   {
+      /* benchmark logger: emulated frames per second to stderr and Caches/fps.log */
+      __block uint64_t lastFrames = 0;
+      __block CFAbsoluteTime lastT = CFAbsoluteTimeGetCurrent();
+      NSString *logPath = [[NSSearchPathForDirectoriesInDomains(NSCachesDirectory, NSUserDomainMask, YES) firstObject] stringByAppendingPathComponent:@"fps.log"];
+      [[NSFileManager defaultManager] removeItemAtPath:logPath error:nil];
+      [NSTimer scheduledTimerWithTimeInterval:5.0 repeats:YES block:^(NSTimer *t) {
+         video_driver_state_t *vs = video_state_get_ptr();
+         uint64_t f = vs->frame_count;
+         CFAbsoluteTime now = CFAbsoluteTimeGetCurrent();
+         NSString *line = [NSString stringWithFormat:@"[FPSLOG] frames=%llu fps=%.1f\n", f, (double)(f - lastFrames) / (now - lastT)];
+         fputs([line UTF8String], stderr); fflush(stderr);
+         FILE *fp = fopen([logPath UTF8String], "a"); if (fp) { fputs([line UTF8String], fp); fclose(fp); }
+         lastFrames = f; lastT = now;
+      }];
+      /* The Philips CD-i player menu waits for PLAY CD-I. Watch the picture: when the grey player menu (or its
+         grey loading screen) is showing, tap A (keyboard x) once, and once more 30 s later if it is still grey.
+         At most two taps in total, and everything stops as soon as a real controller button is pressed or
+         after 7 minutes, so nothing is ever injected into the game itself. */
+      __block int tapsDone = 0;
+      __block BOOL stopped = NO;
+      __block CFAbsoluteTime lastTap = 0;
+      CFAbsoluteTime startT = CFAbsoluteTimeGetCurrent();
+      [NSTimer scheduledTimerWithTimeInterval:2.0 repeats:YES block:^(NSTimer *t) {
+         CFAbsoluteTime now = CFAbsoluteTimeGetCurrent();
+         if (stopped || tapsDone >= 2 || now - startT > 420.0) { [t invalidate]; return; }
+         for (GCController *c in [GCController controllers])
+         {
+            GCExtendedGamepad *g = c.extendedGamepad;
+            if (g && (g.buttonA.isPressed || g.buttonB.isPressed || g.buttonX.isPressed || g.buttonY.isPressed
+                      || g.leftShoulder.isPressed || g.rightShoulder.isPressed || g.dpad.up.isPressed || g.dpad.down.isPressed
+                      || g.dpad.left.isPressed || g.dpad.right.isPressed || g.buttonMenu.isPressed))
+            { stopped = YES; [t invalidate]; return; }
+            if (c.microGamepad.buttonA.isPressed) { stopped = YES; [t invalidate]; return; }
+         }
+         video_driver_state_t *vs = video_state_get_ptr();
+         const uint8_t *px = (const uint8_t *)vs->frame_cache_data;
+         unsigned w = vs->frame_cache_width, h = vs->frame_cache_height;
+         if (!px || w < 16 || h < 16 || (intptr_t)px == -1) return;
+         int gray = 0, total = 0; long bright = 0;
+         for (int gy = 0; gy < 12; gy++)
+            for (int gx = 0; gx < 16; gx++)
+            {
+               unsigned x = (w * (2 * gx + 1)) / 32, y = (h * (2 * gy + 1)) / 24;
+               int r, gg, b;
+               if (vs->pix_fmt == RETRO_PIXEL_FORMAT_XRGB8888)
+               { const uint8_t *q = px + y * vs->frame_cache_pitch + x * 4; b = q[0]; gg = q[1]; r = q[2]; }
+               else
+               { uint16_t v = *(const uint16_t *)(px + y * vs->frame_cache_pitch + x * 2);
+                 if (vs->pix_fmt == RETRO_PIXEL_FORMAT_RGB565) { r = (v >> 11) << 3; gg = ((v >> 5) & 63) << 2; b = (v & 31) << 3; }
+                 else { r = ((v >> 10) & 31) << 3; gg = ((v >> 5) & 31) << 3; b = (v & 31) << 3; } }
+               int mx = MAX(r, MAX(gg, b)), mn = MIN(r, MIN(gg, b));
+               total++; bright += (r + gg + b) / 3;
+               if (mx - mn < 24) gray++;
+            }
+         double ratio = (double)gray / total, avg = (double)bright / total;
+         BOOL greyScreen = ratio >= 0.75 && avg > 90 && avg < 215;
+         NSString *line = [NSString stringWithFormat:@"[AUTOPRESS] t=%.0f gray=%.2f avg=%.0f taps=%d\n", now - startT, ratio, avg, tapsDone];
+         FILE *fp = fopen([logPath UTF8String], "a"); if (fp) { fputs([line UTF8String], fp); fclose(fp); }
+         if (greyScreen && (tapsDone == 0 || now - lastTap >= 30.0))
+         {
+            tapsDone++; lastTap = now;
+            apple_input_keyboard_event(true, 27, 0, 0, RETRO_DEVICE_KEYBOARD);
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.3 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+               apple_input_keyboard_event(false, 27, 0, 0, RETRO_DEVICE_KEYBOARD);
+            });
+         }
+      }];
+   }
